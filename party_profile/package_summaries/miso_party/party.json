    "PartyCreatedEvent": {
      "index": 3,
      "doc": " Emitted when a party is created (creation and `share` happen in the same\n transaction, so this is the indexer's discovery signal). The creator's\n address is deliberately NOT in the payload: Sui's event envelope already\n carries the transaction sender, and the party's controlling identity is\n the (transferable) `PartyAdminCap` holder, not the creation sender.",
      "attributes": [],
      "abilities": [
        "Copy",
        "Drop"
      ],
      "type_parameters": [],
      "fields": {
        "positional_fields": false,
        "fields": {
          "party_id": {
            "index": 0,
            "doc": " ID of the newly created party.",
            "type_": {
              "Datatype": {
                "module": {
                  "address": "sui",
                  "name": "object"
                },
                "name": "ID",
                "type_arguments": []
              }
            }
          },
          "name": {
            "index": 1,
            "doc": " Name of the party.",
            "type_": {
              "Datatype": {
